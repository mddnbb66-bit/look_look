# ===========================================
# Vision-Craft 后端环境变量配置模板
# ===========================================
# 使用说明：
# 1. 复制此文件并重命名为 .env：cp .env.example .env
# 2. 根据下方说明填写对应的配置值
# 3. 不要将 .env 文件提交到 Git 仓库
# ===========================================

# -------------------------------------------
# 基础服务器配置
# -------------------------------------------

# 服务器监听端口
# 默认值：3000
# 说明：后端服务启动时使用的端口号，确保该端口未被其他程序占用
PORT=3000

# -------------------------------------------
# 数据库配置（MongoDB）
# -------------------------------------------

# MongoDB 连接字符串
# 格式：mongodb://用户名:密码@主机:端口/数据库名
# 本地开发示例：mongodb://localhost:27017/vision-craft
# MongoDB Atlas 示例：mongodb+srv://用户名:密码@集群地址/?appName=应用名
# 说明：存储用户数据、对话记录等核心业务数据
MONGODB_URI=mongodb://localhost:27017/vision-craft

# -------------------------------------------
# JWT 认证配置
# -------------------------------------------

# JWT 密钥
# 说明：用于生成和验证用户登录令牌，请使用随机生成的强密钥
# 生成方式：终端执行 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# JWT 过期时间
# 示例值：7d（7天）、24h（24小时）、60m（60分钟）
# 说明：用户登录令牌的有效期，过期后需要重新登录
JWT_EXPIRES_IN=7d

# -------------------------------------------
# 跨域配置（CORS）
# -------------------------------------------

# 允许的前端来源
# 示例值：http://localhost:5173（Vite 开发服务器默认端口）
# 生产环境示例：https://your-domain.com
# 说明：前端应用的访问地址，用于跨域资源共享策略
CORS_ORIGIN=http://localhost:5173

# -------------------------------------------
# AI 模型配置（DeepSeek）
# -------------------------------------------

# DeepSeek API 密钥
# 获取方式：访问 https://platform.deepseek.com 注册账号并创建 API Key
# 说明：用于调用 DeepSeek 大语言模型进行智能对话
DEEPSEEK_API_KEY=your-deepseek-api-key

# DeepSeek API 基础地址
# 默认值：https://api.deepseek.com
# 说明：DeepSeek 官方 API 端点，一般无需修改
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的语言模型
# 可选值：deepseek-chat（通用对话）、deepseek-reasoner（推理增强）
# 说明：选择不同的模型会影响 AI 的回答质量和响应速度
LLM_MODEL=deepseek-reasoner

# -------------------------------------------
# 搜索 API 配置（ExaSearch）
# -------------------------------------------

# ExaSearch API 密钥
# 获取方式：访问 https://exa.ai 注册账号并获取 API Key
# 说明：用于联网搜索功能，让 AI 能够获取实时信息
EXASEARCH_API_KEY=your-exasearch-api-key

# -------------------------------------------
# MongoDB Atlas 向量存储配置（RAG 知识库）
# -------------------------------------------

# MongoDB Atlas 连接字符串
# 格式：mongodb+srv://用户名:密码@集群地址/?appName=应用名
# 获取方式：
#   1. 访问 https://cloud.mongodb.com 注册账号
#   2. 创建免费集群（M0 级别即可）
#   3. 在 "Database Access" 中创建数据库用户
#   4. 在 "Network Access" 中添加 IP 白名单（开发环境可设置为 0.0.0.0/0）
#   5. 点击 "Connect" 获取连接字符串
# 说明：用于存储文档向量化后的数据，支持 RAG 智能问答
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=vision-craft

# Atlas 数据库名称
# 默认值：vision-craft
MONGODB_ATLAS_DB_NAME=vision-craft

# Atlas 向量集合名称
# 默认值：knowledge_vectors
# 说明：存储文档向量的集合名，一般无需修改
MONGODB_ATLAS_COLLECTION_NAME=knowledge_vectors

# -------------------------------------------
# 智谱 AI 配置（用于 Embedding 向量化）
# -------------------------------------------

# 智谱 API 基础地址
# 默认值：https://open.bigmodel.cn/api/paas/v4/
# 说明：智谱官方 API 端点，一般无需修改
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 智谱 API 密钥
# 获取方式：访问 https://open.bigmodel.cn 注册账号并创建 API Key
# 说明：用于调用智谱的 Embedding 模型进行文本向量化
ZHIPU_API_KEY=your-zhipu-api-key

# 智谱对话模型
# 默认值：glm-4.7-flash
# 说明：用于 AI 对话功能的备用模型
ZHIPU_MODEL=glm-4.7-flash

# 智谱 Embedding 模型
# 默认值：embedding-3
# 说明：用于将文本转换为向量，支持 RAG 知识库功能
ZHIPU_EMBEDDING_MODEL=embedding-3

# -------------------------------------------
# 可选：自定义 Embedding 配置
# -------------------------------------------
# 如果需要使用其他 Embedding 服务（如 OpenAI），取消注释并配置以下选项

# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small

# ===========================================
# 常见问题排查
# ===========================================
#
# Q: 启动报错 "MongoDB connection failed"
# A: 检查 MONGODB_URI 是否正确，确保 MongoDB 服务已启动
#
# Q: AI 对话无响应
# A: 检查 DEEPSEEK_API_KEY 是否有效，账户是否有余额
#
# Q: 跨域错误 (CORS Error)
# A: 确保 CORS_ORIGIN 与前端实际访问地址完全一致（包含协议和端口）
#
# Q: RAG 知识库功能不工作
# A: 检查 MongoDB Atlas 连接和智谱 API Key 配置是否正确
# ===========================================
